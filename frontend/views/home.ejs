<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Airbnb Clone</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');

      * { box-sizing: border-box; }
      :root {
        --pink: #ff385c;
        --pink-dark: #d61f4d;
        --text: #222222;
        --muted: #6a6a6a;
        --bg: #f7f7f7;
        --card: #ffffff;
        --line: #ebebeb;
        --shadow: rgba(0, 0, 0, 0.08);
      }
      body {
        margin: 0;
        font-family: 'Manrope', Arial, Helvetica, sans-serif;
        background: var(--bg);
        color: var(--text);
      }
      a { text-decoration: none; color: inherit; }
      img { display: block; max-width: 100%; }

      .topbar {
        background: rgba(255,255,255,0.96);
        border-bottom: 1px solid var(--line);
        padding: 18px 40px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 10;
        backdrop-filter: blur(8px);
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-size: 2rem;
        font-weight: 900;
        color: var(--pink);
        letter-spacing: -0.08em;
        text-transform: none;
      }
      .brand-mark {
        width: 30px;
        height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: radial-gradient(circle at 30% 30%, #ff8d9d, #ff5a5f 28%, #ff385c 52%, #d62954 100%);
        color: white;
        font-size: 12px;
        font-weight: 900;
        box-shadow: 0 12px 22px rgba(255, 56, 92, 0.22);
        transform: rotate(-8deg);
        border: 2px solid rgba(255,255,255,0.8);
      }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 14px;
        font-weight: 700;
      }
      .nav-links a,
      .nav-links .user-pill {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 16px;
        border-radius: 999px;
        transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease, color 180ms ease, border-color 180ms ease;
        animation: navPulse 500ms ease-out both;
      }
      .nav-links a {
        color: var(--text);
      }
      .nav-links a:hover {
        transform: translateY(-2px) scale(1.02);
      }
      .nav-links a:not(.pill):hover {
        background: #fff4f6;
        color: var(--pink);
        box-shadow: 0 8px 18px rgba(255, 56, 92, 0.08);
      }
      .nav-links .user-pill {
        background: rgba(255, 56, 92, 0.08);
        color: var(--pink);
        font-size: 0.92rem;
        border: 1px solid rgba(255, 56, 92, 0.12);
      }
      .nav-links .pill,
      .nav-links .logout-pill {
        background: linear-gradient(135deg, var(--pink), #dd2f53);
        color: white;
        padding: 10px 18px;
        border-radius: 999px;
        box-shadow: 0 12px 22px rgba(255, 56, 92, 0.2);
      }
      .nav-links .pill:hover,
      .nav-links .logout-pill:hover {
        background: linear-gradient(135deg, #ff4a6e, #d8274f);
        box-shadow: 0 14px 26px rgba(255, 56, 92, 0.28);
      }
      @keyframes navPulse {
        0% {
          transform: translateY(3px);
          opacity: 0.75;
        }
        100% {
          transform: translateY(0);
          opacity: 1;
        }
      }

      .container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 30px 20px 80px;
      }

      .hero {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 28px;
        align-items: center;
        background: linear-gradient(135deg, #fff1f2 0%, #ffe4e8 30%, #fff 100%);
        border-radius: 32px;
        padding: 48px 42px;
        box-shadow: 0 26px 60px var(--shadow);
        border: 1px solid #f8dfe4;
      }
      .hero-copy h1 {
        font-size: clamp(2.8rem, 5vw, 5rem);
        line-height: 0.96;
        letter-spacing: -0.06em;
        margin: 0 0 18px;
      }
      .hero-copy p {
        color: var(--muted);
        font-size: 1.12rem;
        line-height: 1.7;
        margin: 0 0 28px;
        max-width: 560px;
      }
      .cta-row {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 15px 24px;
        border-radius: 999px;
        font-weight: 700;
        transition: transform 180ms ease, box-shadow 180ms ease, filter 180ms ease, background 180ms ease;
        animation: navPulse 500ms ease-out both;
      }
      .btn:hover {
        transform: translateY(-2px) scale(1.02);
        box-shadow: 0 12px 22px rgba(255, 56, 92, 0.18);
        filter: brightness(1.03);
      }
      .btn.primary {
        background: linear-gradient(135deg, var(--pink), #dd2f53);
        color: white;
        box-shadow: 0 14px 28px rgba(255, 56, 92, 0.25);
      }
      .btn.secondary {
        background: white;
        color: var(--text);
        border: 1px solid #e8e8e8;
      }
      .btn.secondary:hover {
        background: #fff5f6;
        color: var(--pink);
      }

      .hero-media {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }
      .hero-media .feature {
        overflow: hidden;
        border-radius: 24px;
        background: var(--card);
        box-shadow: 0 18px 32px rgba(0,0,0,0.08);
      }
      .hero-media img {
        width: 100%;
        height: 220px;
        object-fit: cover;
      }
      .hero-media .feature.tall img {
        height: 100%;
        min-height: 420px;
      }
      .feature .caption {
        padding: 14px 16px 18px;
        font-weight: 700;
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(180px, 1fr));
        gap: 18px;
        margin-top: 28px;
      }
      .stat {
        background: white;
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 18px 20px;
      }
      .stat strong {
        display: block;
        font-size: 1.8rem;
        margin-bottom: 6px;
      }
      .stat span {
        color: var(--muted);
      }

      .section {
        margin-top: 52px;
      }
      .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
      }
      .section-header h2 {
        margin: 0;
        font-size: clamp(1.7rem, 3vw, 2.4rem);
        letter-spacing: -0.05em;
      }
      .section-header a {
        color: var(--pink);
        font-weight: 700;
      }

      .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 22px;
      }
      .mini-card {
        background: white;
        border-radius: 22px;
        overflow: hidden;
        border: 1px solid var(--line);
        box-shadow: 0 18px 28px rgba(0,0,0,0.04);
      }
      .mini-card img {
        width: 100%;
        height: 220px;
        object-fit: cover;
      }
      .mini-card .body {
        padding: 16px;
      }
      .mini-card h3 {
        margin: 0 0 8px;
        font-size: 1.08rem;
      }
      .mini-card p {
        margin: 0;
        color: var(--muted);
      }

      .feature-panel {
        display: grid;
        grid-template-columns: repeat(3, minmax(220px, 1fr));
        gap: 18px;
        margin-top: 18px;
      }
      .feature-box {
        background: white;
        border: 1px solid var(--line);
        border-radius: 20px;
        padding: 24px 20px;
      }
      .feature-box .icon {
        display: inline-flex;
        width: 52px;
        height: 52px;
        border-radius: 15px;
        background: #fff1f3;
        color: var(--pink);
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 16px;
      }
      .feature-box h3 {
        margin: 0 0 10px;
      }
      .feature-box p {
        margin: 0;
        color: var(--muted);
        line-height: 1.7;
      }

      @media (max-width: 920px) {
        .hero {
          grid-template-columns: 1fr;
          padding: 32px 22px;
        }
        .feature-panel,
        .stats {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="brand"><span class="brand-mark">W</span>Wanderlust</div>
      <nav class="nav-links">
        <a href="/listings">Stays</a>
        <% if (currentUser) { %>
          <span class="user-pill">Hi, <%= currentUser.name || currentUser.email %></span>
          <a class="logout-pill" href="/logout">Logout</a>
        <% } else { %>
          <a href="/signin">Sign in</a>
          <a class="pill" href="/listings/new">Host</a>
        <% } %>
      </nav>
    </header>

    <main class="container">
      <section class="hero">
        <div class="hero-copy">
          <h1>Not just a stay,<br>an experience.</h1>
          <p>
            Discover handpicked homes, stylish cabins, and city escapes designed for unforgettable stays.
            Book a unique place that feels like your own.
          </p>
          <div class="cta-row">
            <a class="btn primary" href="/listings">Explore stays</a>
            <a class="btn secondary" href="/signin">Become a host</a>
          </div>

          <div class="stats">
            <div class="stat">
              <strong>1.2M+</strong>
              <span>happy guests</span>
            </div>
            <div class="stat">
              <strong>220k</strong>
              <span>listings worldwide</span>
            </div>
            <div class="stat">
              <strong>4.9/5</strong>
              <span>average rating</span>
            </div>
          </div>
        </div>

        <div class="hero-media">
          <div class="feature tall">
            <img src="https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=900&q=80" alt="Luxury home" />
            <div class="caption">Luxury villa</div>
          </div>
          <div class="feature">
            <img src="https://images.unsplash.com/photo-1494526585095-c41746248156?auto=format&fit=crop&w=800&q=80" alt="Cabin stay" />
            <div class="caption">Cozy cabin</div>
          </div>
          <div class="feature">
            <img src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=800&q=80" alt="Modern apartment" />
            <div class="caption">City apartment</div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-header">
          <h2>Popular destinations</h2>
          <a href="/listings">View all</a>
        </div>

        <div class="card-grid">
          <article class="mini-card">
            <img src="https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1000&q=80" alt="Bali" />
            <div class="body">
              <h3>Bali</h3>
              <p>Beachfront escapes</p>
            </div>
          </article>
          <article class="mini-card">
            <img src="https://images.unsplash.com/photo-1493246507139-91e8fad9978e?auto=format&fit=crop&w=1000&q=80" alt="Swiss Alps" />
            <div class="body">
              <h3>Swiss Alps</h3>
              <p>Mountain cabins</p>
            </div>
          </article>
          <article class="mini-card">
            <img src="https://images.unsplash.com/photo-1514565131-fce0801e5785?auto=format&fit=crop&w=1000&q=80" alt="Paris" />
            <div class="body">
              <h3>Paris</h3>
              <p>Charming city stays</p>
            </div>
          </article>
          <article class="mini-card">
            <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1000&q=80" alt="Maldives" />
            <div class="body">
              <h3>Maldives</h3>
              <p>Oceanfront villas</p>
            </div>
          </article>
        </div>
      </section>

      <section class="section">
        <div class="section-header">
          <h2>Why travelers choose us</h2>
        </div>

        <div class="feature-panel">
          <div class="feature-box">
            <div class="icon">★</div>
            <h3>Curated stays</h3>
            <p>Thoughtfully chosen homes with exceptional comfort and style.</p>
          </div>
          <div class="feature-box">
            <div class="icon">✓</div>
            <h3>Fast booking</h3>
            <p>Book instantly with flexible options and easy checkout.</p>
          </div>
          <div class="feature-box">
            <div class="icon">⌂</div>
            <h3>Trusted hosts</h3>
            <p>Stay with verified hosts and enjoy a welcoming experience.</p>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
