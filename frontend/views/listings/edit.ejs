<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Listing • Airbnb Clone</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');

      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: 'Manrope', Arial, Helvetica, sans-serif;
        background: #f7f7f7;
        color: #1f1f1f;
      }
      .topbar {
        background: #fff;
        border-bottom: 1px solid #ebebeb;
        padding: 18px 40px;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 1.9rem;
        font-weight: 800;
        color: #ff385c;
        letter-spacing: -0.05em;
      }
      .brand-mark {
        width: 30px;
        height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: radial-gradient(circle at 30% 30%, #ff8d9d, #ff5a5f 28%, #ff385c 52%, #d62954 100%);
        color: white;
        font-size: 12px;
        font-weight: 900;
        box-shadow: 0 12px 22px rgba(255, 56, 92, 0.22);
        transform: rotate(-8deg);
        border: 2px solid rgba(255,255,255,0.8);
      }
      .container {
        max-width: 700px;
        margin: 44px auto;
        background: white;
        border-radius: 24px;
        border: 1px solid #efefef;
        box-shadow: 0 8px 24px rgba(0,0,0,0.04);
        padding: 30px;
      }
      h1 { margin-top: 0; }
      form { display: flex; flex-direction: column; gap: 18px; }
      label { display: flex; flex-direction: column; gap: 8px; font-weight: 600; }
      input, textarea, button { padding: 14px 16px; font-size: 1rem; border-radius: 12px; }
      input, textarea { border: 1px solid #d9d9d9; }
      button {
        background: linear-gradient(135deg, #ff385c, #d62954);
        color: white;
        border: none;
        font-weight: 700;
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="brand"><span class="brand-mark">W</span>Wanderlust</div>
    </header>

    <main class="container">
      <h1>Edit listing</h1>
      <form action="/listings/<%= listing._id %>/edit" method="POST">
        <label>
          Title
          <input type="text" name="listing[title]" value="<%= listing.title %>" required />
        </label>
        <label>
          Description
          <textarea name="listing[description]" rows="4" required><%= listing.description %></textarea>
        </label>
        <label>
          Image URL
          <input type="url" name="listing[image][url]" value="<%= listing.image && listing.image.url ? listing.image.url : '' %>" required />
        </label>
        <label>
          Price per night
          <input type="number" name="listing[price]" min="0" value="<%= listing.price %>" required />
        </label>
        <label>
          Sale Price
          <input type="number" name="listing[salePrice]" min="0" value="<%= listing.salePrice || '' %>" />
        </label>
        <label>
          Location
          <input type="text" name="listing[location]" value="<%= listing.location %>" required />
        </label>
        <label>
          Country
          <input type="text" name="listing[country]" value="<%= listing.country %>" required />
        </label>
        <button type="submit">Save changes</button>
      </form>
    </main>
  </body>
</html>
