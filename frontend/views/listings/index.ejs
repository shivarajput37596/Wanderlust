<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Stays • Airbnb Clone</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');

      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: 'Manrope', Arial, Helvetica, sans-serif;
        background: #f7f7f7;
        color: #1f1f1f;
      }
      a { text-decoration: none; color: inherit; }
      .topbar {
        background: #fff;
        border-bottom: 1px solid #ebebeb;
        padding: 18px 40px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .topbar a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 16px;
        border-radius: 999px;
        color: #222;
        background: #fff;
        border: 1px solid #efe5e5;
        transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease, color 180ms ease;
        animation: navPulse 500ms ease-out both;
      }
      .topbar a:hover {
        transform: translateY(-2px) scale(1.02);
        background: #fff4f6;
        color: #ff385c;
        box-shadow: 0 10px 20px rgba(255, 56, 92, 0.1);
      }
      @keyframes navPulse {
        0% { transform: translateY(3px); opacity: 0.75; }
        100% { transform: translateY(0); opacity: 1; }
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 1.9rem;
        font-weight: 800;
        color: #ff385c;
        letter-spacing: -0.05em;
      }
      .brand-mark {
        width: 30px;
        height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: radial-gradient(circle at 30% 30%, #ff8d9d, #ff5a5f 28%, #ff385c 52%, #d62954 100%);
        color: white;
        font-size: 12px;
        font-weight: 900;
        box-shadow: 0 12px 22px rgba(255, 56, 92, 0.22);
        transform: rotate(-8deg);
        border: 2px solid rgba(255,255,255,0.8);
      }
      .container {
        max-width: 1200px;
        margin: 32px auto;
        padding: 0 20px;
      }
      .toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 26px;
        flex-wrap: wrap;
      }
      .search-wrap {
        display: flex;
        align-items: center;
        background: white;
        border: 1px solid #e4e4e4;
        border-radius: 999px;
        overflow: hidden;
      }
      .search-wrap input {
        border: none;
        padding: 14px 18px;
        font-size: 1rem;
        width: min(420px, 60vw);
        outline: none;
      }
      .search-wrap button,
      .new-link {
        border: none;
        background: linear-gradient(135deg, #ff385c, #d62954);
        color: white;
        padding: 14px 18px;
        font-weight: 700;
        cursor: pointer;
      }
      .new-link {
        border-radius: 12px;
        display: inline-block;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 22px;
      }
      .card {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 8px 20px rgba(0,0,0,0.05);
      }
      .card img {
        display: block;
        width: 100%;
        height: 250px;
        object-fit: cover;
      }
      .card-body {
        padding: 16px;
      }
      .card h3 {
        margin: 0 0 8px;
        font-size: 1.08rem;
      }
      .meta {
        color: #666;
        margin: 0 0 10px;
      }
      .price {
        font-weight: 700;
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="brand"><span class="brand-mark">W</span>Wanderlust</div>
      <a href="/">Home</a>
    </header>

    <main class="container">
      <div class="toolbar">
        <h1>Places to stay</h1>
        <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
          <form class="search-wrap" action="/listings" method="GET">
            <input type="text" name="q" value="<%= searchTerm || '' %>" placeholder="Search destinations" />
            <button type="submit">Search</button>
          </form>
          <a class="new-link" href="/listings/new">Add new</a>
        </div>
      </div>

      <div class="grid">
        <% if (allListings && allListings.length) { %>
          <% allListings.forEach((listing) => { %>
            <article class="card">
              <a href="/listings/<%= listing._id %>">
                <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1200&q=80' %>" alt="<%= listing.title %>" />
              </a>
              <div class="card-body">
                <a href="/listings/<%= listing._id %>">
                  <h3><%= listing.title %></h3>
                </a>
                <p class="meta"><%= listing.location %>, <%= listing.country %></p>
                <div class="price">₹<%= listing.price %> / night</div>
              </div>
            </article>
          <% }) %>
        <% } else { %>
          <p>No listings found.</p>
        <% } %>
      </div>
    </main>
  </body>
</html>
