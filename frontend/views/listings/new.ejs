<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Become a Host • Wanderlust</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');

      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: 'Manrope', Arial, sans-serif;
        background: linear-gradient(180deg, #fff7f8 0%, #f7f7f7 18%, #f7f7f7 100%);
        color: #1f1f1f;
      }
      a { text-decoration: none; color: inherit; }

      .topbar {
        background: rgba(255,255,255,0.94);
        border-bottom: 1px solid #ebebeb;
        padding: 18px 40px;
        position: sticky;
        top: 0;
        z-index: 5;
        backdrop-filter: blur(6px);
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-size: 2rem;
        font-weight: 900;
        color: #ff385c;
        letter-spacing: -0.08em;
        text-transform: none;
      }
      .brand-mark {
        width: 30px;
        height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: radial-gradient(circle at 30% 30%, #ff8d9d, #ff5a5f 28%, #ff385c 52%, #d62954 100%);
        color: white;
        font-size: 12px;
        font-weight: 900;
        box-shadow: 0 12px 22px rgba(255, 56, 92, 0.22);
        transform: rotate(-8deg);
        border: 2px solid rgba(255,255,255,0.8);
      }

      .container {
        max-width: 880px;
        margin: 48px auto 80px;
        background: rgba(255,255,255,0.97);
        border-radius: 30px;
        border: 1px solid #efefef;
        box-shadow: 0 24px 60px rgba(0,0,0,0.06);
        padding: 34px 32px;
      }
      .header-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 28px;
      }
      h1 {
        margin: 0;
        font-size: clamp(2.2rem, 4vw, 3.5rem);
        letter-spacing: -0.06em;
      }
      .badge {
        background: #fff1f3;
        color: #ff385c;
        border: 1px solid #ffdfe6;
        border-radius: 999px;
        padding: 9px 14px;
        font-size: 0.8rem;
        font-weight: 800;
      }

      form {
        display: grid;
        grid-template-columns: repeat(2, minmax(220px, 1fr));
        gap: 18px 20px;
      }
      .full { grid-column: 1 / -1; }
      label {
        display: flex;
        flex-direction: column;
        gap: 8px;
        font-weight: 700;
        color: #2b2b2b;
      }
      input, textarea, button {
        font-family: 'Manrope', Arial, sans-serif;
      }
      input, textarea {
        width: 100%;
        padding: 15px 16px;
        font-size: 1rem;
        border-radius: 14px;
        border: 1px solid #dcdcdc;
        background: white;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }
      input:focus, textarea:focus {
        outline: none;
        border-color: #ff385c;
        box-shadow: 0 0 0 4px rgba(255,56,92,0.1);
      }
      textarea {
        resize: vertical;
        min-height: 120px;
      }
      button {
        grid-column: 1 / -1;
        margin-top: 8px;
        border: none;
        background: linear-gradient(135deg, #ff385c 0%, #d62954 100%);
        color: white;
        border-radius: 14px;
        padding: 16px 18px;
        font-size: 1rem;
        font-weight: 800;
        cursor: pointer;
        box-shadow: 0 16px 32px rgba(255,56,92,0.18);
      }

      @media (max-width: 700px) {
        .container { padding: 22px 18px; }
        form { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="brand"><span class="brand-mark">W</span>Wanderlust</div>
    </header>

    <main class="container">
      <div class="header-box">
        <h1>List your place</h1>
        <div class="badge">Host your home</div>
      </div>

      <form action="/listings" method="POST">
        <label class="full">
          Title
          <input type="text" name="listing[title]" placeholder="Beautiful villa in the mountains" required />
        </label>

        <label class="full">
          Description
          <textarea name="listing[description]" rows="4" placeholder="Tell guests what makes your place special..." required></textarea>
        </label>

        <label class="full">
          Image URL
          <input type="url" name="listing[image][url]" placeholder="https://example.com/house.jpg" required />
        </label>

        <label>
          Price per night
          <input type="number" name="listing[price]" min="0" placeholder="1500" required />
        </label>

        <label>
          Sale Price
          <input type="number" name="listing[salePrice]" min="0" placeholder="25000" />
        </label>

        <label>
          Location
          <input type="text" name="listing[location]" placeholder="Malibu" required />
        </label>

        <label>
          Country
          <input type="text" name="listing[country]" placeholder="United States" required />
        </label>

        <button type="submit">Create listing</button>
      </form>
    </main>
  </body>
</html>
