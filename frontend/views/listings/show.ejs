<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= listing.title %> • Airbnb Clone</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');

      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: 'Manrope', Arial, Helvetica, sans-serif;
        background: #f7f7f7;
        color: #1f1f1f;
      }
      a { text-decoration: none; color: inherit; }
      .topbar {
        background: #fff;
        border-bottom: 1px solid #ebebeb;
        padding: 18px 40px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .topbar a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 16px;
        border-radius: 999px;
        color: #222;
        background: #fff;
        border: 1px solid #efe5e5;
        transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease, color 180ms ease;
        animation: navPulse 500ms ease-out both;
      }
      .topbar a:hover {
        transform: translateY(-2px) scale(1.02);
        background: #fff4f6;
        color: #ff385c;
        box-shadow: 0 10px 20px rgba(255, 56, 92, 0.1);
      }
      @keyframes navPulse {
        0% { transform: translateY(3px); opacity: 0.75; }
        100% { transform: translateY(0); opacity: 1; }
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 1.9rem;
        font-weight: 800;
        color: #ff385c;
        letter-spacing: -0.05em;
      }
      .brand-mark {
        width: 30px;
        height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: radial-gradient(circle at 30% 30%, #ff8d9d, #ff5a5f 28%, #ff385c 52%, #d62954 100%);
        color: white;
        font-size: 12px;
        font-weight: 900;
        box-shadow: 0 12px 22px rgba(255, 56, 92, 0.22);
        transform: rotate(-8deg);
        border: 2px solid rgba(255,255,255,0.8);
      }
      .container {
        max-width: 1180px;
        margin: 32px auto 60px;
        padding: 0 20px;
      }
      .title-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        align-items: center;
        margin-bottom: 20px;
      }
      h1 {
        margin: 0;
        font-size: clamp(2rem, 4vw, 2.7rem);
      }
      .gallery {
        display: grid;
        grid-template-columns: 2.1fr 1fr 1fr;
        gap: 12px;
        margin-bottom: 22px;
      }
      .gallery img {
        width: 100%;
        height: 100%;
        min-height: 260px;
        display: block;
        object-fit: cover;
        border-radius: 20px;
      }
      .gallery .main { grid-row: 1 / span 2; }
      .gallery .main img { min-height: 510px; }
      .content-wrap {
        display: grid;
        grid-template-columns: 1.8fr 0.9fr;
        gap: 26px;
      }
      .info-box,
      .booking-card,
      .review-card {
        background: white;
        border: 1px solid #ececec;
        border-radius: 22px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.04);
      }
      .info-box {
        padding: 28px;
      }
      .meta {
        color: #555;
        margin: 6px 0 18px;
        font-size: 1rem;
      }
      .host-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 16px;
        border-bottom: 1px solid #efefef;
        margin-bottom: 18px;
      }
      .host-badge {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: linear-gradient(135deg, #ff385c, #d62954);
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
      }
      .description {
        line-height: 1.7;
        color: #333;
      }
      .amenities {
        display: grid;
        grid-template-columns: repeat(2, minmax(180px, 1fr));
        gap: 12px 18px;
        margin-top: 18px;
      }
      .amenity {
        padding: 12px 14px;
        border-radius: 12px;
        background: #fafafa;
        border: 1px solid #f0f0f0;
      }
      .booking-card {
        padding: 24px;
        position: sticky;
        top: 20px;
      }
      .price-line {
        display: flex;
        align-items: baseline;
        gap: 8px;
        margin-bottom: 18px;
      }
      .price-line strong {
        font-size: 2rem;
      }
      .booking-card form {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .booking-card select,
      .booking-card button {
        width: 100%;
        padding: 14px 16px;
        border-radius: 12px;
        border: 1px solid #d9d9d9;
        font-size: 1rem;
      }
      .booking-card button {
        border: none;
        background: linear-gradient(135deg, #ff385c, #d62954);
        color: white;
        font-weight: 700;
        cursor: pointer;
      }
      .summary {
        padding-top: 14px;
        border-top: 1px solid #efefef;
        margin-top: 16px;
      }
      .summary-row {
        display: flex;
        justify-content: space-between;
        margin: 10px 0;
      }
      .reviews {
        margin-top: 34px;
      }
      .review-summary {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 14px;
        margin-bottom: 18px;
        padding: 18px 20px;
        border-radius: 18px;
        background: linear-gradient(135deg, #fff4f6, #ffffff);
        border: 1px solid #f7dfe5;
      }
      .rating-score {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 1.7rem;
        font-weight: 800;
        color: #222;
      }
      .stars {
        color: #ffb400;
        letter-spacing: 0.08em;
      }
      .review-form {
        background: white;
        border: 1px solid #ececec;
        border-radius: 20px;
        padding: 22px;
        margin-bottom: 22px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.03);
      }
      .review-form h3 {
        margin: 0 0 14px;
        font-size: 1.4rem;
      }
      .review-form form {
        display: grid;
        gap: 16px;
      }
      .review-form label {
        display: flex;
        flex-direction: column;
        gap: 8px;
        font-weight: 700;
        color: #333;
      }
      .review-form select,
      .review-form textarea,
      .review-form button {
        width: 100%;
        padding: 14px 16px;
        border-radius: 12px;
        border: 1px solid #d9d9d9;
        font: inherit;
      }
      .review-form textarea {
        min-height: 110px;
        resize: vertical;
      }
      .review-form button {
        border: none;
        background: linear-gradient(135deg, #ff385c, #d62954);
        color: white;
        font-weight: 700;
        cursor: pointer;
      }
      .review-form .signin-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 18px;
        border-radius: 12px;
        background: #fff4f6;
        color: #ff385c;
        font-weight: 700;
        text-decoration: none;
      }
      .reviews-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
        margin-top: 18px;
      }
      .review-card {
        padding: 18px;
      }
      .review-card strong { display: block; margin-bottom: 8px; }
      .review-card .review-rating {
        display: inline-block;
        margin: 4px 0 12px;
        padding: 6px 10px;
        border-radius: 999px;
        background: #fff4f6;
        color: #ff385c;
        font-weight: 800;
      }
      .review-card p { margin: 0; line-height: 1.6; color: #444; }
      .actions {
        display: flex;
        gap: 12px;
        margin-top: 18px;
      }
      .small-btn {
        display: inline-block;
        padding: 10px 16px;
        border-radius: 10px;
        border: 1px solid #e9e9e9;
        background: white;
        font-weight: 600;
      }
      @media (max-width: 900px) {
        .gallery, .content-wrap { grid-template-columns: 1fr; }
        .gallery .main { grid-row: auto; }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="brand"><span class="brand-mark">W</span>Wanderlust</div>
      <a href="/listings">Back to stays</a>
    </header>

    <main class="container">
      <div class="title-row">
        <div>
          <h1><%= listing.title %></h1>
          <div class="meta"><%= listing.location %>, <%= listing.country %></div>
        </div>

        <% if (isOwner) { %>
          <div class="actions">
            <a class="small-btn" href="/listings/<%= listing._id %>/edit">Edit</a>
            <form action="/listings/<%= listing._id %>/delete" method="POST">
              <button class="small-btn" type="submit">Delete</button>
            </form>
          </div>
        <% } %>
      </div>

      <div class="gallery">
        <div class="main">
          <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1200&q=80' %>" alt="<%= listing.title %>" />
        </div>
        <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1200&q=80' %>" alt="" />
        <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1200&q=80' %>" alt="" />
        <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1200&q=80' %>" alt="" />
        <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1200&q=80' %>" alt="" />
      </div>

      <div class="content-wrap">
        <section class="info-box">
          <div class="host-row">
            <div>
              <h2 style="margin:0;">Entire home hosted by Wanderlust</h2>
              <div class="meta">2 guests · 1 bedroom · 1 bed · 1 bath</div>
            </div>
            <div class="host-badge">A</div>
          </div>

          <p class="description"><%= listing.description %></p>

          <h3 style="margin-top:24px;">What this place offers</h3>
          <div class="amenities">
            <div class="amenity">Wifi</div>
            <div class="amenity">Kitchen</div>
            <div class="amenity">Air conditioning</div>
            <div class="amenity">Free parking</div>
            <div class="amenity">Self check-in</div>
            <div class="amenity">City views</div>
          </div>
        </section>

        <aside class="booking-card">
          <div class="price-line">
            <strong>₹<%= listing.price %></strong>
            <span>/ night</span>
          </div>

          <form action="/listings/<%= listing._id %>/checkout" method="POST">
            <select name="mode" required>
              <option value="rent">Rent</option>
              <option value="buy">Buy</option>
            </select>
            <select name="paymentMethod" required>
              <option value="upi">UPI</option>
              <option value="card">Card</option>
              <option value="netbanking">Net Banking</option>
            </select>
            <button type="submit">Reserve</button>
          </form>

          <div class="summary">
            <div class="summary-row"><span>₹<%= listing.price %> x 5 nights</span><span>₹<%= listing.price * 5 %></span></div>
            <div class="summary-row"><span>Service fee</span><span>₹699</span></div>
            <div class="summary-row" style="font-weight:700; font-size:1.05rem;"><span>Total</span><span>₹<%= (listing.price * 5) + 699 %></span></div>
          </div>
        </aside>
      </div>

      <section class="reviews">
        <h2>Guest reviews</h2>

        <%
          const totalReviews = Array.isArray(listing.reviews) ? listing.reviews.length : 0;
          const averageRating = totalReviews ? (listing.reviews.reduce((sum, review) => sum + Number(review.rating || 0), 0) / totalReviews).toFixed(1) : '0.0';
          const stars = totalReviews ? '★'.repeat(Math.round(Number(averageRating))) + '☆'.repeat(5 - Math.round(Number(averageRating))) : '☆☆☆☆☆';
        %>

        <div class="review-summary">
          <div class="rating-score">
            <span><%= averageRating %></span>
            <span class="stars"><%= stars %></span>
          </div>
          <div><strong><%= totalReviews %></strong> guest review<%= totalReviews === 1 ? '' : 's' %></div>
        </div>

        <div class="review-form">
          <% if (currentUser) { %>
            <h3>Leave a rating & feedback</h3>
            <form action="/listings/<%= listing._id %>/reviews" method="POST">
              <label>
                Rating
                <select name="review[rating]" required>
                  <option value="5">5 - Excellent</option>
                  <option value="4">4 - Very good</option>
                  <option value="3">3 - Good</option>
                  <option value="2">2 - Fair</option>
                  <option value="1">1 - Poor</option>
                </select>
              </label>
              <label>
                Feedback
                <textarea name="review[comment]" placeholder="Tell other travelers what stood out..." required></textarea>
              </label>
              <button type="submit">Submit review</button>
            </form>
          <% } else { %>
            <h3>Leave a rating & feedback</h3>
            <a class="signin-cta" href="/signin?message=<%= encodeURIComponent('Please sign in to leave a review.') %>">Sign in to review</a>
          <% } %>
        </div>

        <div class="reviews-grid">
          <% if (listing.reviews && listing.reviews.length) { %>
            <% listing.reviews.forEach((review) => { %>
              <div class="review-card">
                <strong><%= review.author %></strong>
                <span class="review-rating"><%= review.rating %>/5 ★</span>
                <p><%= review.comment %></p>
              </div>
            <% }) %>
          <% } else { %>
            <div class="review-card">
              <p>No reviews yet. Be the first to share your experience.</p>
            </div>
          <% } %>
        </div>
      </section>
    </main>
  </body>
</html>
